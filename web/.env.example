# SLUGS on Robinhood Chain (defaults are in src/config.ts; set these only to override)
VITE_TOKEN_SYMBOL=SLUGS
VITE_TOKEN_ADDRESS=0xa5A0A37778D6b656A37b2E10c13E2E31826ff10A
# Baum Telegram bot and SLUGS' Baum referral code
VITE_BAUM_BOT=BaumReviewBot
VITE_BAUM_REF=MINT-FLASH-38
# Server-side only, never VITE_*: set BAUM_API_KEY in the Vercel project's environment.
# api/data.js uses it to read Baum's leaderboard; without it the site reads the
# Agent Trading Platform's published copy (DATA_FALLBACK_URL).
BAUM_API_KEY=
