{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/data.js": { "includeFiles": "server-assets/**" }
  },
  "rewrites": [
    { "source": "/share/pnl", "destination": "/api/data?pnl=1" },
    { "source": "/api/pnl", "destination": "/api/data?pnl=1" },
    { "source": "/i/:token", "destination": "/api/data?invitation=page&token=:token" },
    { "source": "/api/invitation", "destination": "/api/data?invitation=1" },
    { "source": "/data/:file.json", "destination": "/api/data?file=:file" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://baumai.xyz; font-src 'self' data:; connect-src 'self' https://rpc.mainnet.chain.robinhood.com; frame-src https://platform.twitter.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
