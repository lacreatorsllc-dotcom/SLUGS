{
  "name": "@slugs/cli",
  "version": "0.1.0",
  "description": "SLUGS CLI — Terminal control center for autonomous trading agents",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "slugs": "./dist/index.js"
  },
  "scripts": {
